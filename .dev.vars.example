# Copy to .dev.vars for local `wrangler dev`. Never commit .dev.vars.
# With FAKE_SERVICES=1 (the default in wrangler.jsonc) none of the vendor keys are needed:
# login codes are returned in the API response and every outside service is a stand-in.
SESSION_SECRET=dev-session-secret-change-me
SECRETS_KEY=YcLVEjArFviauClfN6thsYumeyr3wqfUT9D2VnMNTm0=
JOB_SHARED_SECRET=dev-job-shared-secret
# GITHUB_DISPATCH_TOKEN=
# RESEND_API_KEY=
# Which deployment this is; /healthz reports it. Production and staging set it in wrangler.jsonc.
ENV_NAME=dev
# How people get in: "code" (the email-code login) locally and in e2e; production is "open".
AUTH_MODE=code
