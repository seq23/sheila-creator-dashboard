{
  "name": "sheila-creator-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sheila's creator dashboard: dump footage, review clips, schedule through Buffer, find brand deals. Owner: Sheila. $0/month target.",
  "scripts": {
    "dev": "wrangler dev",
    "dev:app": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate.mjs",
    "validate:envs": "node scripts/validate.mjs envs-match",
    "validate:looks": "node scripts/validate.mjs looks",
    "check": "npm run typecheck && npm run test && npm run validate && npm run build",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "e2e:open": "playwright test -c playwright.open.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply sheila-creator-dashboard-db --local",
    "db:migrate:production": "wrangler d1 migrations apply sheila-creator-dashboard-db --remote",
    "db:migrate:staging": "wrangler d1 migrations apply sheila-creator-dashboard-db-staging --remote --env staging",
    "deploy:production": "bash scripts/deploy-production.sh",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "help:screenshots": "playwright test tests/e2e/help-screenshots.spec.ts"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.0",
    "@cloudflare/workers-types": "^5.20260925.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=22"
  }
}
