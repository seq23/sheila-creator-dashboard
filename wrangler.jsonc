// Sheila Creator Dashboard — one Worker serves the React app (static assets),
// the API, the media links Buffer fetches, and the cron jobs.
//
// Why one Worker and not Pages + Worker (the plan said Pages): one deploy, one
// origin, no CORS, and Workers Static Assets is the direction Cloudflare has
// moved Pages toward. Nothing about the plan's behaviour changes.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production Worker: https://sheilastudio.seq-taylor.workers.dev (renamed 26 Sep 2026 from
  // sheila-creator-dashboard at the owner's request; the D1 database and R2 bucket kept their names).
  "name": "sheilastudio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "8d147e242033699dd37c6f5a451f48d2",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API and media routes must reach the Worker even when a file could match.
    "run_worker_first": ["/api/*", "/media/*", "/healthz", "/kit/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sheila-creator-dashboard-db",
      "database_id": "f2ddb225-deb9-42e6-b77c-3a122621792f",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "sheila-creator-dashboard-files" }
  ],
  "triggers": {
    "crons": [
      "0 * * * *",     // hourly: Buffer sync (load next posts, read back status, retry failures)
      "30 13 * * *",   // daily 13:30 UTC: supply monitor + health check + emails
      "0 12 * * 1"     // Monday 12:00 UTC: weekly recap, learning update, brand finder
    ]
  },
  "vars": {
    // Plain-text configuration only. Every key lives in `wrangler secret`.
    "APP_NAME": "Sheila Studio",
    "OWNER_EMAIL": "asheilabruceaffair@gmail.com",
    // "1" swaps every outside service (Buffer, OpenRouter, Firecrawl, Resend, Hunter, GitHub,
    // Meta, Google) for a realistic stand-in. Production sets it to "0".
    "FAKE_SERVICES": "1",
    // Local default. Production's URL (https://sheilastudio.seq-taylor.workers.dev) is set by
    // scripts/deploy-production.sh with --var, so `wrangler dev` never mints Secure cookies on http.
    "PUBLIC_BASE_URL": "http://localhost:8787",
    "GITHUB_REPO": "seq23/sheila-creator-dashboard",
    "AUDIENCE_TIMEZONE": "America/New_York",
    // Which deployment this is: "production" here, "staging" in env.staging, "dev" in .dev.vars.
    // /healthz reports it and every job dispatch carries it, so a job reaches the right
    // Worker, bucket and shared secret.
    "ENV_NAME": "production",
    // How people get in. "open": no login at all, every visitor is the owner (OWNER_EMAIL):
    // the owner's choice for production, anyone with the URL is the owner. "code": the email
    // one-time-code login (staging below; .dev.vars and tests/e2e/serve.sh for local and e2e).
    // Switching production back: AUTH_MODE "code" here and REQUIRED_AUTH_MODE in
    // scripts/validators/envs-match.mjs (which enforces both modes), then a deploy.
    "AUTH_MODE": "open"
  },
  // STAGING: the owner's own fully real copy (FAKE_SERVICES=0) for testing with throwaway
  // accounts while Sheila's production stays untouched. Deploy with `npm run deploy:staging`.
  // scripts/validators/envs-match.mjs fails the build if staging differs from production in
  // anything except the name, the D1/R2 ids and names, and the vars OWNER_EMAIL,
  // PUBLIC_BASE_URL, ENV_NAME, FAKE_SERVICES and AUTH_MODE.
  "env": {
    "staging": {
      "name": "sheila-creator-dashboard-staging",
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/media/*", "/healthz", "/kit/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sheila-creator-dashboard-db-staging",
          "database_id": "c8e9e2c9-0c30-48c5-9c93-acf66a26979c",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "sheila-creator-dashboard-files-staging" }
      ],
      "triggers": {
        "crons": ["0 * * * *", "30 13 * * *", "0 12 * * 1"]
      },
      "vars": {
        "APP_NAME": "Sheila Studio",
        // The West Peek Resend key delivers only to its account owner's address, so staging logs in there.
        "OWNER_EMAIL": "sequoia@westpeek.ventures",
        "FAKE_SERVICES": "0",
        "PUBLIC_BASE_URL": "https://sheila-creator-dashboard-staging.seq-taylor.workers.dev",
        "GITHUB_REPO": "seq23/sheila-creator-dashboard",
        "AUDIENCE_TIMEZONE": "America/New_York",
        "ENV_NAME": "staging",
        // Staging keeps the email-code login (the owner's instruction, 26 Sep 2026).
        "AUTH_MODE": "code"
      }
    }
  }
  // Secrets (set with `wrangler secret put <NAME>`), all prefixed with the vendor name so no
  // reserved env name is ever reused:
  //   SESSION_SECRET          signs login sessions
  //   SECRETS_KEY             AES-GCM key (base64, 32 bytes) that encrypts connection keys at rest
  //   JOB_SHARED_SECRET       HMAC between the Worker and GitHub Actions jobs
  //   GITHUB_DISPATCH_TOKEN   fine-grained PAT, contents:write on this repo, used only to start jobs
  //   RESEND_API_KEY          transactional email
  // Per-user connection keys (Buffer, OpenRouter, Firecrawl, Hunter, Meta, Google) are NOT
  // secrets here: she pastes them in Connect accounts and they are stored encrypted in D1.
}
